#!/bin/sh
# Auto-append commit subject line to CHANGELOG.md
set -e

CHANGELOG="CHANGELOG.md"
COMMIT_MSG=$(git log -1 --format="%s")
COMMIT_DATE=$(git log -1 --format="%ad" --date=short)
COMMIT_HASH=$(git log -1 --format="%h")

# Check if changelog exists
if [ ! -f "$CHANGELOG" ]; then
  printf '# NativeThink 开发日志\n' > "$CHANGELOG"
fi

# 空行规整 + 新日期标题插入。旧写法 `sed i\` 在标题上方固定留一行空行，
# 每来一个新日期就多堆一行（2026-10-05 已堆到 10 行），这里改成一次全文件重写：
# 连续空行压成一行；需要新标题时插在首个日期标题之前，两侧各留一个空行。
TODAY_HEADER="## $COMMIT_DATE"
NEED_INSERT=0
if ! grep -q "$TODAY_HEADER" "$CHANGELOG" && grep -q "^## [0-9]" "$CHANGELOG"; then
  NEED_INSERT=1
fi
TMP="$CHANGELOG.tmp"
awk -v d="$COMMIT_DATE" -v need="$NEED_INSERT" '
  /^[[:space:]]*$/ { blanks++; next }
  {
    if (need == 1 && !ins && $0 ~ /^## [0-9]/) {
      if (blanks > 0) print ""
      printf "## %s\n\n", d
      ins = 1
      blanks = 0
    }
    if (blanks > 0) { print ""; blanks = 0 }
    print
  }
' "$CHANGELOG" > "$TMP" && mv "$TMP" "$CHANGELOG"

# 首次写入（文件里还没有任何日期标题）：直接追加
if ! grep -q "^## [0-9]" "$CHANGELOG"; then
  printf '\n## %s\n' "$COMMIT_DATE" >> "$CHANGELOG"
fi

# Append commit message as bullet after the date header
# Insert after the date header line
DATE_LINE=$(grep -n "^## $COMMIT_DATE" "$CHANGELOG" | head -1 | cut -d: -f1)
if [ -n "$DATE_LINE" ]; then
  # Check if this commit message is already in the log
  if ! grep -q "$COMMIT_MSG" "$CHANGELOG"; then
    sed -i "${DATE_LINE}a\\- $COMMIT_MSG (\`$COMMIT_HASH\`)" "$CHANGELOG"
  fi
fi

# Copy to public/ for in-app display
cp "$CHANGELOG" public/CHANGELOG.md 2>/dev/null || true

# Stage both for next commit
git add "$CHANGELOG" public/CHANGELOG.md 2>/dev/null || true
